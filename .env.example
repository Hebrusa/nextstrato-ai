# Clé API Anthropic — obtenir sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Google Drive integration (optionnel)
# 1. Créez un projet sur https://console.cloud.google.com
# 2. Activez "Google Drive API" et "Google Picker API"
# 3. Créez une clé API (Credentials > API Key) → NEXT_PUBLIC_GOOGLE_API_KEY
# 4. Créez un OAuth 2.0 Client ID (Web application) → NEXT_PUBLIC_GOOGLE_CLIENT_ID
#    Authorized JavaScript origins: http://localhost:3000 (dev) + votre domaine prod
NEXT_PUBLIC_GOOGLE_API_KEY=AIza...
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
